{
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "plugins": [
    "prettier-plugin-java",
    "@prettier/plugin-xml",
    "prettier-plugin-sql",
    "prettier-plugin-sh"
  ],
  "overrides": [
    {
      "files": "*.java",
      "options": { "tabWidth": 4 }
    },
    {
      "files": "backend/pom.xml",
      "options": { "tabWidth": 4, "xmlWhitespaceSensitivity": "ignore" }
    },
    {
      "files": "*.sql",
      "options": { "language": "mysql" }
    },
    {
      "files": "*.md",
      "options": { "embeddedLanguageFormatting": "off" }
    }
  ]
}
